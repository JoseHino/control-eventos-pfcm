# Copia este fichero como .env y rellena los valores. El .env esta excluido del repo.
#
# Aqui NO va ninguna clave maestra. El ETL escribe autenticado como un usuario del
# equipo de AMMA y la politica RLS solo le deja escribir por tener rol 'amma'. Si
# estas credenciales se comprometen, se cambia la contrasena del usuario y ya esta.
# La clave service_role NUNCA debe guardarse en el equipo ni en este fichero.

SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
SUPABASE_ANON_KEY=<clave publicable del proyecto>

AMMA_EMAIL=<correo del usuario con rol amma>
AMMA_PASSWORD=<contrasena de ese usuario>
